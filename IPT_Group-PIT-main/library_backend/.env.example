# Example environment variables for Django email configuration
DJANGO_SECRET_KEY=your-secret-key-here

# Use console backend in development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Gmail SMTP, use these values:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-sender@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL="Library System <your-sender@gmail.com>"
